# Copy to .env.local and fill in from the Firebase console (Project settings → Your apps).
# The values below are the emulator placeholders; the emulator does not validate them.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-greatforge.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-greatforge
VITE_FIREBASE_STORAGE_BUCKET=demo-greatforge.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# true routes auth and Firestore at the local emulator suite (npm run emulators).
VITE_USE_FIREBASE_EMULATOR=true
